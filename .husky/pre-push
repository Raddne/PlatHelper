# Blocking CI checks that can run on the current platform. Packaging stays CI-only.
# bypass: git push --no-verify
set -e
pnpm run verify:onnx-models
pnpm typecheck
pnpm run backend:typecheck
pnpm run check
pnpm lint
pnpm run format:check
pnpm audit --prod --audit-level high
pnpm run audit:deadcode
pnpm test
pnpm run backend:test
pnpm run build

# Electron sometimes crashes while exiting after every check has passed; that
# alone earns a repeat (scripts/retry-exit-crash.mjs, three attempts at most), a real failure never.
if [ "${OS:-}" = "Windows_NT" ]; then
  node scripts/retry-exit-crash.mjs pnpm run test:dbwin
  node scripts/retry-exit-crash.mjs pnpm run test:reward-scan
  node scripts/retry-exit-crash.mjs pnpm run test:e2e:built
fi
